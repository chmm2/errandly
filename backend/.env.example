# Copy to backend/.env and adjust. Never commit the real .env.

# --- Database (async SQLAlchemy) ---
DATABASE_URL=postgresql+asyncpg://errandly:errandly@db:5432/errandly

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
# Exact origins. Loopback and LAN addresses on ANY port are additionally
# matched by CORS_ORIGIN_REGEX (see app/core/config.py) — Metro moves the Expo
# web build off 8081 whenever that port is busy, and an unlisted origin fails
# in a way that looks like "login is broken in the browser but fine on the
# phone", because native clients never perform a CORS preflight.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:19092
KAFKA_ORDERS_TOPIC=errandly.orders
