# Copy to backend/.env and adjust. Never commit the real .env.

# --- Database (async SQLAlchemy) ---
DATABASE_URL=postgresql+asyncpg://errandly:errandly@db:5432/errandly

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:19092
KAFKA_ORDERS_TOPIC=errandly.orders
