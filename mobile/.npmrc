# expo-router pulls in react-dom (for its web target) at a newer patch than the
# react version Expo SDK 57 pins, so a strict peer-dep resolution fails with
# ERESOLVE. The conflict is confined to web-only packages this app never bundles.
#
# EAS Build runs a clean install in the cloud, so this has to be committed —
# passing --legacy-peer-deps locally isn't enough.
legacy-peer-deps=true
